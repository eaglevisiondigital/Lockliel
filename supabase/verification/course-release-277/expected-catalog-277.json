  "constraints": [
    {
      "name": "course_answer_keys_answers_check",
      "table": "course_answer_keys",
      "validated": true,
      "definition": "CHECK ((jsonb_typeof(answers) = 'object'::text))"
    },
    {
      "name": "course_answer_keys_lesson_id_fkey",
      "table": "course_answer_keys",
      "validated": true,
      "definition": "FOREIGN KEY (lesson_id) REFERENCES lessons(id) ON DELETE CASCADE"
    },
    {
      "name": "course_answer_keys_pkey",
      "table": "course_answer_keys",
      "validated": true,
      "definition": "PRIMARY KEY (lesson_id, configuration_version)"
    },
    {
      "name": "course_learning_rules_shape",
      "table": "courses",
      "validated": true,
      "definition": "CHECK (((jsonb_typeof(learning_rules) = 'object'::text) AND ((learning_rules = '{}'::jsonb) OR ((learning_rules ?& ARRAY['model'::text, 'sequential'::text, 'watch_threshold'::text, 'minimum_score'::text]) AND ((learning_rules ->> 'model'::text) = ANY (ARRAY['watch_answer'::text, 'watch_score'::text, 'simple'::text, 'review'::text])) AND ((learning_rules ->> 'model'::text) IS NOT NULL) AND (jsonb_typeof((learning_rules -> 'sequential'::text)) = 'boolean'::text) AND (jsonb_typeof((learning_rules -> 'watch_threshold'::text)) = 'number'::text) AND (jsonb_typeof((learning_rules -> 'minimum_score'::text)) = 'number'::text) AND ((((learning_rules ->> 'watch_threshold'::text))::numeric >= (1)::numeric) AND (((learning_rules ->> 'watch_threshold'::text))::numeric <= (100)::numeric)) AND ((((learning_rules ->> 'minimum_score'::text))::numeric >= (0)::numeric) AND (((learning_rules ->> 'minimum_score'::text))::numeric <= (100)::numeric))))))"
    },
    {
      "name": "getting_a_grip_permanent_rule",
      "table": "courses",
      "validated": true,
      "definition": "CHECK (((translation_key IS DISTINCT FROM 'getting-a-grip-on-the-basics'::text) OR COALESCE((((learning_rules ->> 'model'::text) = 'watch_answer'::text) AND (((learning_rules ->> 'watch_threshold'::text))::numeric = (95)::numeric) AND (((learning_rules ->> 'minimum_score'::text))::numeric = (0)::numeric) AND ((learning_rules ->> 'sequential'::text))::boolean AND COALESCE(((learning_rules ->> 'worksheet_required'::text))::boolean, true)), false)))"
    },
    {
      "name": "lesson_asset_duration_source_consistency",
      "table": "lesson_assets",
      "validated": true,
      "definition": "CHECK ((((duration_seconds IS NULL) AND (duration_verification_source IS NULL)) OR ((duration_seconds IS NOT NULL) AND (duration_verification_source IS NOT NULL))))"
    },
    {
      "name": "lesson_assets_duration_verification_source_check",
      "table": "lesson_assets",
      "validated": true,
      "definition": "CHECK (((duration_verification_source IS NULL) OR ((char_length(duration_verification_source) >= 10) AND (char_length(duration_verification_source) <= 500))))"
    },
    {
      "name": "lesson_private_notes_body_check",
      "table": "lesson_private_notes",
      "validated": true,
      "definition": "CHECK ((char_length(body) <= 12000))"
    },
    {
      "name": "lesson_private_notes_pkey",
      "table": "lesson_private_notes",
      "validated": true,
      "definition": "PRIMARY KEY (profile_id, lesson_id)"
    },
    {
      "name": "lesson_private_notes_profile_id_lesson_id_fkey",
      "table": "lesson_private_notes",
      "validated": true,
      "definition": "FOREIGN KEY (profile_id, lesson_id) REFERENCES lesson_progress(profile_id, lesson_id) ON DELETE CASCADE"
    },
    {
      "name": "lessons_configuration_version_check",
      "table": "lessons",
      "validated": true,
      "definition": "CHECK ((configuration_version > 0))"
    }
  ],
  "policies": [
    {
      "cmd": "SELECT",
      "qual": "((profile_id = ( SELECT auth.uid() AS uid)) AND app_private.current_session_is_active())",
      "roles": [
        "authenticated"
      ],
      "tablename": "lesson_private_notes",
      "permissive": "PERMISSIVE",
      "policyname": "lesson_private_notes_owner",
      "schemaname": "public",
      "with_check": null
    },
    {
      "cmd": "INSERT",
      "qual": null,
      "roles": [
        "authenticated"
      ],
      "tablename": "lesson_progress",
      "permissive": "RESTRICTIVE",
      "policyname": "engine_lesson_insert",
      "schemaname": "public",
      "with_check": "(EXISTS ( SELECT 1\n   FROM (lessons l\n     JOIN courses c ON ((c.id = l.course_id)))\n  WHERE ((l.id = lesson_progress.lesson_id) AND (c.learning_rules = '{}'::jsonb))))"
    },
    {
      "cmd": "UPDATE",
      "qual": "(EXISTS ( SELECT 1\n   FROM (lessons l\n     JOIN courses c ON ((c.id = l.course_id)))\n  WHERE ((l.id = lesson_progress.lesson_id) AND (c.learning_rules = '{}'::jsonb))))",
      "roles": [
        "authenticated"
      ],
      "tablename": "lesson_progress",
      "permissive": "RESTRICTIVE",
      "policyname": "engine_lesson_update",
      "schemaname": "public",
      "with_check": null
    },
    {
      "cmd": "INSERT",
      "qual": null,
      "roles": [
        "authenticated"
      ],
      "tablename": "media_progress",
      "permissive": "RESTRICTIVE",
      "policyname": "engine_media_insert",
      "schemaname": "public",
      "with_check": "(EXISTS ( SELECT 1\n   FROM ((lesson_assets a\n     JOIN lessons l ON ((l.id = a.lesson_id)))\n     JOIN courses c ON ((c.id = l.course_id)))\n  WHERE ((a.id = media_progress.asset_id) AND (c.learning_rules = '{}'::jsonb) AND (NOT (EXISTS ( SELECT 1\n           FROM courses family\n          WHERE ((family.translation_key = c.translation_key) AND (family.learning_rules <> '{}'::jsonb))))))))"
    },
    {
      "cmd": "UPDATE",
      "qual": "(EXISTS ( SELECT 1\n   FROM ((lesson_assets a\n     JOIN lessons l ON ((l.id = a.lesson_id)))\n     JOIN courses c ON ((c.id = l.course_id)))\n  WHERE ((a.id = media_progress.asset_id) AND (c.learning_rules = '{}'::jsonb) AND (NOT (EXISTS ( SELECT 1\n           FROM courses family\n          WHERE ((family.translation_key = c.translation_key) AND (family.learning_rules <> '{}'::jsonb))))))))",
      "roles": [
        "authenticated"
      ],
      "tablename": "media_progress",
      "permissive": "RESTRICTIVE",
      "policyname": "engine_media_update",
      "schemaname": "public",
      "with_check": null
    }
  ],
